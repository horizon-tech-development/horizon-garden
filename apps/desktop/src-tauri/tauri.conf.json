{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Horizon Garden",
  "version": "0.1.0",
  "identifier": "com.horizontech.garden",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Horizon Garden", "width": 1100, "height": 820, "minWidth": 760, "minHeight": 620 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
